<Window
    x:Class="RaysLoader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="{ThemeResource RlBackgroundBrush}" ActualThemeChanged="RootGrid_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource RlSurfaceBrush}" BorderBrush="{ThemeResource RlRuleBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppLogo" Width="22" Height="22" Margin="16,0,10,0" />
                <TextBlock
                    x:Name="AppNameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="ExtraBold"
                    FontStretch="SemiExpanded"
                    CharacterSpacing="40" />
                <MenuBar Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                    <MenuBarItem Title="File">
                        <MenuFlyoutItem Text="Add download" KeyboardAcceleratorTextOverride="Ctrl+N" Click="AddDownload_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Edit">
                        <MenuFlyoutItem Text="Paste and add" KeyboardAcceleratorTextOverride="Ctrl+V" Click="PasteAndAdd_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="View">
                        <MenuFlyoutItem Text="Downloads" Click="ShowDownloads_Click" />
                        <MenuFlyoutItem Text="Settings" Click="ShowSettings_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Downloads">
                        <MenuFlyoutItem Text="Retry all failed" Click="RetryAll_Click" />
                        <MenuFlyoutItem Text="Stop all" Click="StopAll_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="Help">
                        <MenuFlyoutItem Text="Supported sites" Click="ShowSupportedSites_Click" />
                        <MenuFlyoutItem Text="Getting started" Click="GettingStarted_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Send feedback">
                            <MenuFlyoutItem Text="Report a bug" Click="ReportBug_Click" />
                            <MenuFlyoutItem Text="Suggest a feature" Click="SuggestFeature_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="View feedback" Click="ViewFeedback_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="AppUpdatesMenuItem" Text="Check for updates" Click="CheckForUpdates_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="About Ray's Loader" Click="ShowAbout_Click" />
                    </MenuBarItem>
                </MenuBar>
                <Grid x:Name="TitleBarDragRegion" Grid.Column="3" Background="Transparent">
                    <StackPanel Margin="20,0,150,0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <Border
                            x:Name="DevelopmentBadge"
                            Padding="7,3"
                            VerticalAlignment="Center"
                            Background="{ThemeResource RlAccentFillBrush}"
                            Visibility="Collapsed">
                            <TextBlock
                                FontFamily="{StaticResource RlMonoStrongFont}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                CharacterSpacing="120"
                                Foreground="{ThemeResource RlAccentInkBrush}"
                                Text="DEV PREVIEW" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,0,150,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource RlLabelTextStyle}"
                        FontSize="10"
                        AutomationProperties.AccessibilityView="Raw">
                        <Run Text="{Binding RunningCount, Converter={StaticResource TwoDigitConverter}}" /><Run Text=" RUNNING / " /><Run Text="{Binding QueuedCount, Converter={StaticResource TwoDigitConverter}}" /><Run Text=" QUEUED" />
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <InfoBar
            x:Name="UpdateInfoBar"
            Grid.Row="1"
            Margin="12,8,12,0"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button Content="Open updates" Click="OpenUpdates_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource RlSurfaceBrush}" BorderBrush="{ThemeResource RlRuleBrush}" BorderThickness="0,0,1,0">
                <Grid x:Name="Rail" Padding="0,20,0,14" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Download filters: everything, then one row per status. -->
                    <StackPanel AutomationProperties.Name="Download filters">
                        <TextBlock Margin="20,0,20,8" Style="{StaticResource RlLabelTextStyle}" FontSize="10" Text="DOWNLOADS" />
                        <RadioButton x:Name="AllItem" Style="{StaticResource RlRailItemStyle}" GroupName="Navigation" CommandParameter="All" Content="All" Tag="{Binding AllCount}" Checked="Rail_Checked" AutomationProperties.Name="All downloads" />

                        <Rectangle Height="1" Margin="20,12,20,14" Fill="{ThemeResource RlRuleBrush}" />
                        <TextBlock Margin="20,0,20,6" Style="{StaticResource RlLabelTextStyle}" FontSize="10" Text="BY STATUS" />
                        <RadioButton Style="{StaticResource RlRailItemStyle}" GroupName="Navigation" CommandParameter="Running" Content="Running" Tag="{Binding RunningCount}" Checked="Rail_Checked" AutomationProperties.Name="Running downloads" />
                        <RadioButton Style="{StaticResource RlRailItemStyle}" GroupName="Navigation" CommandParameter="Queued" Content="Queued" Tag="{Binding QueuedCount}" Checked="Rail_Checked" AutomationProperties.Name="Queued downloads" />
                        <RadioButton Style="{StaticResource RlRailItemStyle}" GroupName="Navigation" CommandParameter="Completed" Content="Completed" Tag="{Binding CompletedCount}" Checked="Rail_Checked" AutomationProperties.Name="Completed downloads" />
                        <RadioButton Style="{StaticResource RlRailItemStyle}" GroupName="Navigation" CommandParameter="Failed" Content="Failed" Tag="{Binding FailedCount}" Checked="Rail_Checked" AutomationProperties.Name="Failed downloads" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="SupportedSitesItem" Style="{StaticResource RlRailItemStyle}" MinHeight="40" FontSize="13" GroupName="Navigation" CommandParameter="SupportedSites" Content="Supported sites" Checked="Rail_Checked" />
                        <RadioButton x:Name="SettingsNavigationItem" Style="{StaticResource RlRailItemStyle}" MinHeight="40" FontSize="13" GroupName="Navigation" CommandParameter="Settings" Content="Settings" Checked="Rail_Checked" />
                        <RadioButton x:Name="AboutItem" Style="{StaticResource RlRailItemStyle}" MinHeight="40" FontSize="13" GroupName="Navigation" CommandParameter="About" Content="About" Checked="Rail_Checked" AutomationProperties.Name="About Ray's Loader" />
                        <TextBlock x:Name="VersionText" Margin="20,14,20,0" Style="{StaticResource RlLabelTextStyle}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
