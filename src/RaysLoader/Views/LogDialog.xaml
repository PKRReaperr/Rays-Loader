<ContentDialog
    x:Class="RaysLoader.Views.LogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Copy log"
    SecondaryButtonText="Save log"
    CloseButtonText="Close"
    PrimaryButtonClick="Copy_Click"
    SecondaryButtonClick="Save_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
    </ContentDialog.Resources>
    <Grid Width="900" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="3">
            <TextBlock Text="{Binding Title}" Style="{StaticResource RlSectionTitleTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Title}" />
            <TextBlock Text="Live yt-dlp and FFmpeg output" Style="{StaticResource RlLabelTextStyle}" />
        </StackPanel>
        <TextBox x:Name="LogTextBox" Grid.Row="1" MinHeight="460" MaxHeight="620" Text="{Binding LogText, Mode=OneWay}" AcceptsReturn="True" IsReadOnly="True" FontFamily="{StaticResource RlMonoFont}" FontSize="12" TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <CheckBox x:Name="FollowOutputCheck" Grid.Row="2" Content="Follow output" IsChecked="True" />
    </Grid>
</ContentDialog>
