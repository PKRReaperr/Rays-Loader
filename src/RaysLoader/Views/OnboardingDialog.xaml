<ContentDialog
    x:Class="RaysLoader.Views.OnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Getting started"
    PrimaryButtonText="Next"
    CloseButtonText="Set up later"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButton_Click"
    SecondaryButtonClick="SecondaryButton_Click"
    CloseButtonClick="CloseButton_Click">
    <Grid Width="480" MinHeight="350">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="7">
            <Grid>
                <TextBlock x:Name="StepLabel" Text="STEP 1 OF 4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StepName" HorizontalAlignment="Right" Text="Welcome" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ProgressBar x:Name="StepProgress" Minimum="1" Maximum="4" Value="1" />
            <InfoBar x:Name="SaveErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <StackPanel x:Name="WelcomeStep" Spacing="16">
                <Image x:Name="WelcomeLogo" Width="72" Height="72" HorizontalAlignment="Left" />
                <TextBlock x:Name="WelcomeTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="This short setup covers the choices that affect every download. You can change them later in Settings." FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Spacing="10">
                    <TextBlock Text="1. Paste one or more media URLs" />
                    <TextBlock Text="2. Select Analyze URL before adding the download" />
                    <TextBlock Text="3. Add items to the queue and start when ready" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="FolderStep" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Choose a download folder" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="This becomes the default destination. Leave it blank to choose a folder separately for each download." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderTextBox" Header="Default output folder" PlaceholderText="No folder selected" IsReadOnly="True" AutomationProperties.Name="Default output folder" />
                    <Button Grid.Column="1" Width="40" Height="32" VerticalAlignment="Bottom" Click="BrowseFolder_Click" AutomationProperties.Name="Choose default output folder" ToolTipService.ToolTip="Choose folder">
                        <FontIcon Glyph="&#xE8B7;" />
                    </Button>
                    <Button Grid.Column="2" Width="40" Height="32" VerticalAlignment="Bottom" Click="ClearFolder_Click" AutomationProperties.Name="Clear default output folder" ToolTipService.ToolTip="Clear folder">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Your choice is local" Message="Ray's Loader saves the selected folder for this Windows account." />
            </StackPanel>

            <StackPanel x:Name="DefaultsStep" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Set your defaults" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="These values prefill the Add download dialog. You can override them for individual downloads." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ComboBox x:Name="QualityComboBox" Header="Video quality" />
                    <ComboBox x:Name="ContainerComboBox" Grid.Column="1" Header="Video container" />
                    <NumberBox x:Name="ConcurrentDownloadsBox" Grid.Row="1" Header="Simultaneous downloads" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <CheckBox x:Name="PlaylistCheckBox" Content="Allow playlists" />
                        <CheckBox x:Name="MetadataCheckBox" Content="Embed metadata" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ReadyStep" Spacing="16" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="52" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Ready to download" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Use Add download, paste your URL, and select Analyze URL. After analysis finishes, choose your options and add the download to the queue." TextWrapping="Wrap" FontSize="15" />
                <TextBlock x:Name="FolderSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="You can reopen this walkthrough from Help > Getting started." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
