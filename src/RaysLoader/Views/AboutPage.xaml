<Page
    x:Class="RaysLoader.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RaysLoader.Controls">
    <Grid Background="{ThemeResource RlBackgroundBrush}">
        <controls:BlueprintGrid LineBrush="{ThemeResource RlGridLineBrush}" CellSize="48" />
        <ScrollViewer>
            <StackPanel MaxWidth="860" HorizontalAlignment="Left" Padding="36,30,36,32" Spacing="22">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" VerticalAlignment="Bottom" Background="{ThemeResource RlSurfaceBrush}" BorderBrush="{ThemeResource RlRuleBrush}" BorderThickness="1">
                        <Image x:Name="AboutLogo" Width="72" Height="72" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="10">
                        <TextBlock Style="{StaticResource RlLabelTextStyle}" Foreground="{ThemeResource RlAccentTextBrush}" Text="{x:Bind VersionText}" />
                        <TextBlock x:Name="AboutNameText" Style="{StaticResource RlDisplayTextStyle}" FontSize="48" LineHeight="46" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource RlPanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="AboutDescriptionText" Style="{StaticResource RlBodyTextStyle}" FontSize="16" Foreground="{ThemeResource RlTextBrush}" />
                        <Grid ColumnSpacing="24" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource RlLabelTextStyle}" Text="PUBLISHER" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RlMonoTextStyle}" Text="Rayware Inc." />
                            <TextBlock Grid.Row="1" Style="{StaticResource RlLabelTextStyle}" Text="ENGINE" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource RlMonoTextStyle}" Text="Powered by yt-dlp and FFmpeg" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource RlLabelTextStyle}" Text="LINKS" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="GitHub repository" NavigateUri="https://github.com/PKRReaperr/Rays-Loader" />
                        <HyperlinkButton Content="Send feedback" NavigateUri="https://github.com/PKRReaperr/Rays-Loader/issues/new/choose" />
                        <HyperlinkButton Content="yt-dlp project" NavigateUri="https://github.com/yt-dlp/yt-dlp" />
                        <HyperlinkButton Content="FFmpeg project" NavigateUri="https://ffmpeg.org/" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource RlToolbarButtonStyle}" Click="SupportedSites_Click" AutomationProperties.Name="Supported sites">SUPPORTED SITES</Button>
                        <Button Style="{StaticResource RlToolbarButtonStyle}" Click="OpenProjectFolder_Click" AutomationProperties.Name="Open project folder">OPEN PROJECT FOLDER</Button>
                    </StackPanel>
                </StackPanel>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Licenses and third-party notices">
                    <TextBlock Style="{StaticResource RlBodyTextStyle}" Text="Ray's Loader is MIT-licensed. yt-dlp source is released under The Unlicense; official PyInstaller executables include GPLv3+ components. The included FFmpeg build is GPLv3. See THIRD-PARTY-NOTICES.md in the application folder for details." />
                </Expander>
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Legal notice" Message="Ray's Loader is not affiliated with YouTube or any supported media website. Users are responsible for complying with applicable laws, website terms, and content rights." />
                <TextBlock Style="{StaticResource RlCaptionTextStyle}" Text="Bug reports and feature suggestions are reviewed through the public GitHub issue tracker." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
