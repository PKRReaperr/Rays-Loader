<Page
    x:Class="RaysLoader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RaysLoader.Controls">
    <Page.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource RlSectionTitleTextStyle}" />
    </Page.Resources>
    <Grid Background="{ThemeResource RlBackgroundBrush}">
    <controls:BlueprintGrid LineBrush="{ThemeResource RlGridLineBrush}" CellSize="48" />
    <Grid Padding="36,30,36,28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Spacing="10">
                <TextBlock Style="{StaticResource RlLabelTextStyle}" Foreground="{ThemeResource RlAccentTextBrush}" Text="// CONFIGURATION" />
                <TextBlock Style="{StaticResource RlDisplayTextStyle}" Text="SETTINGS" AutomationProperties.HeadingLevel="Level1" AutomationProperties.Name="Settings" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="12">
                <ProgressRing Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <Button Style="{StaticResource RlToolbarAccentButtonStyle}" Click="Save_Click" AutomationProperties.Name="Save settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="13" Glyph="&#xE74E;" />
                        <TextBlock Text="SAVE SETTINGS" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{Binding StatusMessage, Converter={StaticResource StringPresenceConverter}}"
            Message="{Binding StatusMessage}"
            Severity="Informational" />

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,18,16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Updates" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Keep Ray's Loader current." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,18,24,22" Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersionText}" />
                        <CheckBox Content="Check automatically when Ray's Loader starts" IsChecked="{Binding Settings.AutomaticallyCheckForUpdates, Mode=TwoWay}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding UpdateProgress}"
                            Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding CheckForUpdatesCommand}">Check for updates</Button>
                            <Button Style="{StaticResource RlAccentButtonStyle}" IsEnabled="{Binding CanDownloadUpdate}" Click="DownloadUpdate_Click">Download and install</Button>
                            <Button Command="{Binding CancelUpdateCommand}" IsEnabled="{Binding IsUpdateBusy}">Cancel</Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Authentication" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Preferences used only when a website requires a sign-in." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="12">
                        <ComboBox
                            Width="300"
                            HorizontalAlignment="Left"
                            Header="Preferred authentication method"
                            ItemsSource="{Binding AuthenticationMethods}"
                            SelectedItem="{Binding SelectedAuthenticationMethod, Mode=TwoWay}" />
                        <StackPanel Spacing="8" Visibility="{Binding UsesBrowserAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ComboBox
                                Width="310"
                                HorizontalAlignment="Left"
                                Header="Signed-in browser"
                                ItemsSource="{Binding Browsers}"
                                SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Sign in on the website using this browser. Ray's Loader only enables these cookies after a site reports that authentication is required. Firefox is recommended on Windows."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnSpacing="8" Visibility="{Binding UsesCookiesFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Default cookies file" Text="{Binding Settings.CookiesFile, Mode=TwoWay}" PlaceholderText="Choose cookies.txt" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseCookies_Click">Browse</Button>
                        </Grid>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Ray's Loader does not store account passwords. Browser cookies and cookie files are sensitive and should never be shared in logs or bug reports."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Authentication only unlocks media types supported by yt-dlp. It does not enable still Flickr photo downloads."
                            TextWrapping="Wrap" />
                        <HyperlinkButton
                            Padding="0"
                            HorizontalAlignment="Left"
                            Content="Open yt-dlp's official authentication guide"
                            NavigateUri="https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Appearance" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Theme and interface colors." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="14">
                        <ComboBox
                            Width="220"
                            HorizontalAlignment="Left"
                            Header="Theme"
                            ItemsSource="{Binding Themes}"
                            SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" />
                        <RadioButtons
                            Header="Accent color"
                            MaxColumns="4"
                            ItemsSource="{Binding AccentColors}"
                            SelectedItem="{Binding Settings.AccentColor, Mode=TwoWay}"
                            SelectionChanged="AccentColor_SelectionChanged"
                            AutomationProperties.Name="Accent color">
                            <RadioButtons.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel MinWidth="124" Orientation="Horizontal" Spacing="8">
                                        <Rectangle
                                            Width="18"
                                            Height="18"
                                            Fill="{Binding Converter={StaticResource AccentColorToBrushConverter}}"
                                            Stroke="{ThemeResource RlRuleStrongBrush}"
                                            StrokeThickness="1" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource AccentColorToLabelConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </RadioButtons.ItemTemplate>
                        </RadioButtons>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="General" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Folders, queue limits, and app behavior." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Default output directory" Text="{Binding Settings.DefaultOutputDirectory, Mode=TwoWay}" PlaceholderText="Choose a folder" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseOutput_Click">Browse</Button>
                        </Grid>
                        <NumberBox
                            Width="220"
                            HorizontalAlignment="Left"
                            Header="Maximum simultaneous downloads"
                            Maximum="8"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding Settings.MaximumSimultaneousDownloads, Mode=TwoWay}" />
                        <CheckBox Content="Confirm before stopping all" IsChecked="{Binding Settings.ConfirmBeforeStoppingAll, Mode=TwoWay}" />
                        <CheckBox Content="Remember window position and size" IsChecked="{Binding Settings.RememberWindowPlacement, Mode=TwoWay}" />
                        <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />
                        <CheckBox Content="Show completion notifications" IsChecked="{Binding Settings.ShowCompletionNotifications, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Download defaults" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Starting choices for new downloads." TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="24,22" ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Header="Video quality" Text="{Binding Settings.DefaultVideoQuality, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="Container" Text="{Binding Settings.DefaultContainer, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Header="Audio format" Text="{Binding Settings.DefaultAudioFormat, Mode=TwoWay}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Header="Audio bitrate" Text="{Binding Settings.DefaultAudioBitrate, Mode=TwoWay}" />
                        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Header="Filename template" Text="{Binding Settings.FilenameTemplate, Mode=TwoWay}" />
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18">
                            <CheckBox Content="Playlists" IsChecked="{Binding Settings.DownloadPlaylists, Mode=TwoWay}" />
                            <CheckBox Content="Subtitles" IsChecked="{Binding Settings.WriteSubtitles, Mode=TwoWay}" />
                            <CheckBox Content="Metadata" IsChecked="{Binding Settings.EmbedMetadata, Mode=TwoWay}" />
                            <CheckBox Content="Thumbnails" IsChecked="{Binding Settings.WriteThumbnail, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Download engine" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="yt-dlp health, updates, and supporting tools." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="12">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Backend status" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding YtDlpVersionText}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding YtDlpSourceText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FfmpegVersionText}" />
                        <TextBlock Text="{Binding JavaScriptRuntimeText}" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ToolStatus}" TextWrapping="Wrap" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Left"
                            IsActive="{Binding IsToolBusy}"
                            Visibility="{Binding IsToolBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox
                            Content="Keep yt-dlp updated when Ray's Loader starts"
                            IsChecked="{Binding Settings.AutomaticallyUpdateYtDlp, Mode=TwoWay}" />
                        <ComboBox
                            Width="180"
                            HorizontalAlignment="Left"
                            Header="yt-dlp update channel"
                            ItemsSource="{Binding YtDlpUpdateChannels}"
                            SelectedItem="{Binding Settings.YtDlpUpdateChannel, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding CheckToolStatusCommand}">Check status</Button>
                            <Button Style="{StaticResource RlAccentButtonStyle}" Command="{Binding UpdateYtDlpCommand}">Update yt-dlp now</Button>
                            <Button Command="{Binding CancelToolOperationCommand}">Cancel</Button>
                        </StackPanel>

                        <Border Height="1" Margin="0,4" Background="{ThemeResource SettingsSectionDividerBrush}" />
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Custom tool paths" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Optional. A custom yt-dlp selection is checked but remains externally managed."
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="yt-dlp path" Text="{Binding Settings.YtDlpPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Tag="yt-dlp" Click="BrowseTool_Click">Browse</Button>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="FFmpeg path" Text="{Binding Settings.FfmpegPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Tag="ffmpeg" Click="BrowseTool_Click">Browse</Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenToolsFolder_Click">Open managed tools folder</Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Advanced" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Network and processing controls." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="10">
                        <TextBox Header="Additional default yt-dlp arguments" Text="{Binding Settings.AdditionalArguments, Mode=TwoWay}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Proxy" Text="{Binding Settings.Proxy, Mode=TwoWay}" PlaceholderText="Optional proxy URL" />
                            <TextBox Grid.Column="1" Header="Rate limit" Text="{Binding Settings.RateLimit, Mode=TwoWay}" PlaceholderText="For example 5M" />
                        </Grid>
                        <NumberBox
                            Width="220"
                            HorizontalAlignment="Left"
                            Header="Concurrent fragments"
                            Maximum="32"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding Settings.ConcurrentFragments, Mode=TwoWay}" />
                        <CheckBox Content="Preserve temporary files" IsChecked="{Binding Settings.PreserveTemporaryFiles, Mode=TwoWay}" />
                        <CheckBox Content="Verbose logging" IsChecked="{Binding Settings.VerboseLogging, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="App data" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect or reset files owned by Ray's Loader." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="10">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Downloaded media, external tools, and cookie files are never removed."
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OpenSettingsFolder_Click">Open app data folder</Button>
                            <Button Click="CleanReset_Click">Clean reset...</Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{ThemeResource SettingsSectionDividerBrush}" />

                <Grid Background="{ThemeResource SettingsSectionBodyBrush}" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Padding="16,22" Background="{ThemeResource SettingsSectionLabelBrush}" Spacing="4">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="Uninstall" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Remove Ray's Loader from this PC." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,22" Spacing="10">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Windows will let you choose whether to keep app data or perform a clean uninstall."
                            TextWrapping="Wrap" />
                        <Button
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Click="OpenWindowsUninstall_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                <TextBlock Text="Uninstall Ray's Loader" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>
</Page>
