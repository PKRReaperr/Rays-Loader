<Page
    x:Class="RaysLoader.Views.DevSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RaysLoader.Controls">
    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource RlPanelStyle}" />
        <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource RlSectionTitleTextStyle}" />
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource RlCaptionTextStyle}" />
        <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource RlTitleTextStyle}">
            <Setter Property="FontSize" Value="22" />
        </Style>
        <Style x:Key="SettingsNavigationStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource RlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource RlRuleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource RlBackgroundBrush}">
        <controls:BlueprintGrid LineBrush="{ThemeResource RlGridLineBrush}" CellSize="48" />
        <Grid Padding="36,30,36,20">
        <Grid MaxWidth="1100" HorizontalAlignment="Stretch" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Spacing="10">
                <TextBlock Style="{StaticResource RlLabelTextStyle}" Foreground="{ThemeResource RlAccentTextBrush}" Text="// DEV" />
                <TextBlock Style="{StaticResource RlDisplayTextStyle}" Text="SETTINGS" AutomationProperties.HeadingLevel="Level1" AutomationProperties.Name="Settings" />
                <TextBlock Style="{StaticResource RlBodyTextStyle}" Text="Tune your local Ray's Loader workspace. Changes save automatically." />
            </StackPanel>
            <Border Grid.Column="1" MinWidth="220" Padding="14,10" VerticalAlignment="Bottom" Background="{ThemeResource RlBackgroundBrush}" BorderBrush="{ThemeResource RlRuleBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Rectangle Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource RlAccentFillBrush}" />
                    <TextBlock x:Name="SaveStatusText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RlMonoTextStyle}" Text="Changes save automatically" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="RetrySaveButton" Grid.Column="2" Padding="10,2" MinHeight="28" Content="Retry" Visibility="Collapsed" Click="RetrySave_Click" />
                </Grid>
            </Border>
        </Grid>

        <InfoBar Grid.Row="1" IsClosable="True" IsOpen="{Binding StatusMessage, Converter={StaticResource StringPresenceConverter}}" Message="{Binding StatusMessage}" Severity="Informational" />

        <Border Grid.Row="2" Style="{StaticResource SettingsNavigationStyle}">
            <NavigationView
                x:Name="SettingsSections"
                Height="48"
                PaneDisplayMode="Top"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTabStop="False"
                SelectionChanged="SettingsSections_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Appearance" Tag="appearance" />
                    <NavigationViewItem Content="Downloads" Tag="downloads" />
                    <NavigationViewItem Content="Engine" Tag="engine" />
                    <NavigationViewItem Content="Authentication" Tag="authentication" />
                    <NavigationViewItem Content="Advanced" Tag="advanced" />
                </NavigationView.MenuItems>
            </NavigationView>
        </Border>
        <ScrollViewer x:Name="SectionScrollViewer" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="SectionScrollViewer_SizeChanged">
                <Grid MaxWidth="920" Margin="0,0,4,8" HorizontalAlignment="Center">
                    <StackPanel x:Name="AppearanceSection" Spacing="12">
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="Make it yours" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Personalize your workspace. Theme and accent changes appear immediately." />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="18">
                                <ComboBox Width="240" HorizontalAlignment="Left" Header="Theme" ItemsSource="{Binding Themes}" SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" SelectionChanged="Theme_SelectionChanged" />
                                <RadioButtons x:Name="AccentChoices" Header="Accent color" MaxColumns="4" ItemsSource="{Binding AccentColors}" SelectedItem="{Binding Settings.AccentColor, Mode=TwoWay}" SelectionChanged="AccentColor_SelectionChanged" AutomationProperties.Name="Accent color">
                                    <RadioButtons.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel MinWidth="108" Orientation="Horizontal" Spacing="8">
                                                <Rectangle Width="18" Height="18" Fill="{Binding Converter={StaticResource AccentColorToBrushConverter}}" Stroke="{ThemeResource RlRuleStrongBrush}" StrokeThickness="1" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource AccentColorToLabelConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </RadioButtons.ItemTemplate>
                                </RadioButtons>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Window and notifications" />
                                <CheckBox Content="Remember window position and size" IsChecked="{Binding Settings.RememberWindowPlacement, Mode=TwoWay}" />
                                <CheckBox Content="Start minimized" IsChecked="{Binding Settings.StartMinimized, Mode=TwoWay}" />
                                <CheckBox Content="Show completion notifications" IsChecked="{Binding Settings.ShowCompletionNotifications, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DownloadsSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="Your download defaults" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Choose where downloads go and the starting options for new downloads." />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Location and queue" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Default output directory" Text="{Binding Settings.DefaultOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Choose a folder" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseOutput_Click" Content="Browse" />
                                </Grid>
                                <NumberBox Width="260" HorizontalAlignment="Left" Header="Maximum simultaneous downloads" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" Value="{Binding Settings.MaximumSimultaneousDownloads, Mode=TwoWay}" />
                                <CheckBox Content="Confirm before stopping all downloads" IsChecked="{Binding Settings.ConfirmBeforeStoppingAll, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Format and filenames" />
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <ComboBox Header="Video quality" HorizontalAlignment="Stretch" ItemsSource="{x:Bind VideoQualities}" SelectedItem="{Binding Settings.DefaultVideoQuality, Mode=TwoWay}" />
                                    <TextBox Grid.Column="1" Header="Container" Text="{Binding Settings.DefaultContainer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Header="Audio format" Text="{Binding Settings.DefaultAudioFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Header="Audio bitrate" Text="{Binding Settings.DefaultAudioBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Row="2" Grid.ColumnSpan="2" Header="Filename template" Text="{Binding Settings.FilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Use best or a resolution such as 1080p for video quality; use a bitrate such as 192K for audio." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Include with downloads" />
                                <CheckBox Content="Download playlists" IsChecked="{Binding Settings.DownloadPlaylists, Mode=TwoWay}" />
                                <CheckBox Content="Write subtitles" IsChecked="{Binding Settings.WriteSubtitles, Mode=TwoWay}" />
                                <CheckBox Content="Embed metadata" IsChecked="{Binding Settings.EmbedMetadata, Mode=TwoWay}" />
                                <CheckBox Content="Write thumbnails" IsChecked="{Binding Settings.WriteThumbnail, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="EngineSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="Download engine" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Keep yt-dlp ready for the sites you download from." />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="{Binding YtDlpVersionText}" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Check for a newer yt-dlp version and install it if one is available." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Style="{StaticResource RlAccentButtonStyle}" Command="{Binding UpdateYtDlpCommand}" Content="{Binding ToolUpdateActionText}" />
                                    <Button Command="{Binding CancelToolOperationCommand}" Content="Cancel" Visibility="{Binding IsToolBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing Width="20" Height="20" IsActive="{Binding IsToolBusy}" Visibility="{Binding IsToolBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding ToolStatus}" AutomationProperties.LiveSetting="Polite" />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <CheckBox Content="Keep yt-dlp updated when Ray's Loader starts" IsChecked="{Binding Settings.AutomaticallyUpdateYtDlp, Mode=TwoWay}" />
                                <ComboBox Width="220" HorizontalAlignment="Left" Header="yt-dlp update channel" ItemsSource="{Binding YtDlpUpdateChannels}" SelectedItem="{Binding Settings.YtDlpUpdateChannel, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Tool details and custom paths" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Inspect installed tools or use your own executables." />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="{Binding YtDlpSourceText}" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding FfmpegVersionText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding JavaScriptRuntimeText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <Button HorizontalAlignment="Left" Command="{Binding CheckToolStatusCommand}" Content="{Binding ToolDetailsActionText}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Refreshing reads the installed tool versions. It does not check for a newer release." />
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Leave paths empty to use managed tools. Custom executables are managed externally and are never overwritten by the updater." />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="yt-dlp path" Text="{Binding Settings.YtDlpPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Managed yt-dlp" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Tag="yt-dlp" Click="BrowseTool_Click" Content="Browse" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="FFmpeg path" Text="{Binding Settings.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Managed FFmpeg" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Tag="ffmpeg" Click="BrowseTool_Click" Content="Browse" />
                                </Grid>
                                <Button HorizontalAlignment="Left" Click="OpenToolsFolder_Click" Content="Open managed tools folder" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel x:Name="AuthenticationSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="Authentication" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Choose how to sign in when a website requires it." />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <ComboBox Width="300" HorizontalAlignment="Left" Header="Preferred authentication method" ItemsSource="{Binding AuthenticationMethods}" SelectedItem="{Binding SelectedAuthenticationMethod, Mode=TwoWay}" />
                                <StackPanel Spacing="10" Visibility="{Binding UsesBrowserAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox Width="300" HorizontalAlignment="Left" Header="Signed-in browser" ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Sign in on the website using this browser. Cookies are used only after a site asks for authentication. Firefox is recommended on Windows." />
                                </StackPanel>
                                <Grid ColumnSpacing="8" Visibility="{Binding UsesCookiesFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Default cookies file" Text="{Binding Settings.CookiesFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Choose cookies.txt" />
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseCookies_Click" Content="Browse" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Ray's Loader does not store account passwords. Keep browser cookies and cookie files private; never include them in logs or bug reports." />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Authentication only unlocks media types supported by yt-dlp. It does not enable still Flickr photo downloads." />
                                <HyperlinkButton Padding="0" HorizontalAlignment="Left" Content="Read the yt-dlp authentication guide" NavigateUri="https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedSection" Spacing="12" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,4" Spacing="4">
                            <TextBlock Style="{StaticResource SettingsSectionHeadingStyle}" Text="Advanced" />
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Network, processing, and maintenance options." />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Network and processing" />
                                <TextBox Header="Additional default yt-dlp arguments" Text="{Binding Settings.AdditionalArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBox Header="Proxy" Text="{Binding Settings.Proxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional proxy URL" />
                                    <TextBox Grid.Column="1" Header="Rate limit" Text="{Binding Settings.RateLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="For example 5M" />
                                </Grid>
                                <NumberBox Width="240" HorizontalAlignment="Left" Header="Concurrent fragments" Minimum="1" Maximum="32" SpinButtonPlacementMode="Compact" Value="{Binding Settings.ConcurrentFragments, Mode=TwoWay}" />
                                <CheckBox Content="Preserve temporary files" IsChecked="{Binding Settings.PreserveTemporaryFiles, Mode=TwoWay}" />
                                <CheckBox Content="Verbose logging" IsChecked="{Binding Settings.VerboseLogging, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="App data and maintenance" />
                                    <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Inspect or reset data belonging to this DEV app." />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Downloaded media, external tools, and cookie files are kept when resetting app data." />
                                <Button HorizontalAlignment="Left" Click="OpenSettingsFolder_Click" Content="Open DEV app data folder" />
                                <Button HorizontalAlignment="Left" Click="CleanReset_Click" Content="Reset DEV app data…" />
                            </StackPanel>
                        </Expander>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource SettingsCardTitleStyle}" Text="Ray's Loader DEV" />
                                <TextBlock Text="{Binding CurrentVersionText}" />
                                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="This app is updated from local DEV builds. yt-dlp updates are managed separately in Engine." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
        </ScrollViewer>
        </Grid>
        </Grid>
    </Grid>
</Page>
