<ContentDialog
    x:Class="RaysLoader.Views.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RaysLoader.Controls"
    xmlns:models="using:RaysLoader.Models"
    Title="Add download"
    PrimaryButtonText="Add to queue"
    SecondaryButtonText="Add &amp; start queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{Binding CanQueue}"
    IsSecondaryButtonEnabled="{Binding CanQueue}"
    PrimaryButtonClick="PrimaryButton_Click"
    SecondaryButtonClick="SecondaryButton_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer
        x:Name="OptionsScrollViewer"
        MaxHeight="620"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="ContentPanel"
            Width="840"
            Spacing="10"
            Padding="0,0,8,0"
            Loaded="ContentPanel_Loaded"
            Unloaded="ContentPanel_Unloaded">
            <InfoBar
                IsOpen="{Binding ErrorMessage, Converter={StaticResource StringPresenceConverter}}"
                IsClosable="False"
                Severity="Error"
                Message="{Binding ErrorMessage}" />

            <TextBox
                Header="Media URL"
                Text="{Binding Urls, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Paste one or more URLs, one per line"
                AcceptsReturn="True"
                MinHeight="64"
                AutomationProperties.Name="Media URLs" />
            <TextBlock
                Margin="2,-8,0,0"
                Text="{Binding UrlInputSummary}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Click="Paste_Click" AutomationProperties.Name="Paste from clipboard"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE77F;" /><TextBlock Text="Paste" /></StackPanel></Button>
                <ProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{Binding IsBusy}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding PreviewStatus}"
                    TextTrimming="CharacterEllipsis" />
                <HyperlinkButton
                    Grid.Column="3"
                    Padding="0"
                    Content="Browse supported sites"
                    NavigateUri="https://github.com/yt-dlp/yt-dlp/blob/master/supportedsites.md" />
            </Grid>

            <ListView
                MaxHeight="210"
                ItemsSource="{Binding Previews}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaPreviewItem">
                        <Border
                            Padding="10"
                            Background="{ThemeResource AppCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
>
                            <Grid MinHeight="76" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource SettingsSectionBodyBrush}">
                                    <Grid>
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="22"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE8B9;" />
                                        <Image
                                            Source="{x:Bind ThumbnailUrl, Mode=OneWay, Converter={StaticResource NullableImageSourceConverter}}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Source, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="2"
                                        Text="{x:Bind Message, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing
                                    Grid.Column="2"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                    Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xEA39;"
                                    Visibility="{x:Bind HasFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Header="Output folder" Text="{Binding OutputDirectory, Mode=TwoWay}" PlaceholderText="Choose a folder" AutomationProperties.Name="Output folder" />
                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseOutput_Click" AutomationProperties.Name="Browse output folder"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8B7;" /><TextBlock Text="Browse" /></StackPanel></Button>
            </Grid>

            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Header="Mode" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}" />
                <ComboBox Grid.Column="1" Header="Video quality" ItemsSource="{Binding VideoQualities}" SelectedItem="{Binding VideoQuality, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" Header="Container" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container, Mode=TwoWay}" />
                <ComboBox Grid.Row="1" Header="Audio format" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioFormat, Mode=TwoWay}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Header="Audio bitrate" ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrate, Mode=TwoWay}" />
                <ComboBox Grid.Row="1" Grid.Column="2" Header="Exact format (optional)" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" DisplayMemberPath="Id" PlaceholderText="Automatic" />
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="Subtitles" IsChecked="{Binding WriteSubtitles, Mode=TwoWay}" />
                <CheckBox Grid.Column="1" Content="Embed metadata" IsChecked="{Binding EmbedMetadata, Mode=TwoWay}" />
                <CheckBox Grid.Column="2" Content="Thumbnail" IsChecked="{Binding WriteThumbnail, Mode=TwoWay}" />
                <CheckBox Grid.Column="3" Content="Allow playlist" IsChecked="{Binding DownloadPlaylist, Mode=TwoWay}" />
            </Grid>

            <Expander Header="Clip selection">
                <StackPanel Spacing="12" Padding="0,10,0,4">
                    <ToggleSwitch Header="Download only the selected range" IsOn="{Binding TrimEnabled, Mode=TwoWay}" IsEnabled="{Binding CanSelectClip}" />
                    <Border
                        Padding="14,12"

                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="START" Style="{StaticResource RlLabelTextStyle}" />
                                    <TextBlock Text="{Binding TrimStartDisplay}" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="16" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="CLIP LENGTH" HorizontalAlignment="Center" Style="{StaticResource RlLabelTextStyle}" />
                                    <TextBlock Text="{Binding TrimLengthDisplay}" HorizontalAlignment="Center" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="14" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="END" HorizontalAlignment="Right" Style="{StaticResource RlLabelTextStyle}" />
                                    <TextBlock Text="{Binding TrimEndDisplay}" HorizontalAlignment="Right" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="16" />
                                </StackPanel>
                            </Grid>
                            <controls:TrimRangeSlider
                                Minimum="0"
                                Maximum="{Binding MediaDurationSeconds}"
                                StartValue="{Binding TrimStartSeconds, Mode=TwoWay}"
                                EndValue="{Binding TrimEndSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding CanSelectClip}"
                                AutomationProperties.Name="Clip timeline range" />
                            <Grid>
                                <TextBlock Text="00:00" Style="{StaticResource RlLabelTextStyle}" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding MediaDurationDisplay}" Style="{StaticResource RlLabelTextStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Expander Header="Fine-tune times">
                        <Grid ColumnSpacing="12" Padding="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox Header="Start (seconds)" Value="{Binding TrimStartSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding MediaDurationSeconds}" SpinButtonPlacementMode="Compact" />
                            <NumberBox Grid.Column="1" Header="End (seconds)" Value="{Binding TrimEndSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding MediaDurationSeconds}" SpinButtonPlacementMode="Compact" />
                        </Grid>
                    </Expander>
                    <ComboBox Header="Clip method" ItemsSource="{Binding ClipMethods}" SelectedItem="{Binding SelectedClipMethod, Mode=TwoWay}" DisplayMemberPath="Label" />
                    <TextBlock Text="Full quality downloads the selected source streams before FFmpeg trims them. Partial methods transfer less data when the source supports efficient seeking." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <CheckBox Content="Precise cuts (partial methods only; slower)" IsChecked="{Binding ExactBoundaries, Mode=TwoWay}" />
                </StackPanel>
            </Expander>

            <Expander Header="Authentication (optional)" IsExpanded="{Binding IsAuthenticationExpanded, Mode=TwoWay}">
                <StackPanel Spacing="12" Padding="0,10,0,4">
                    <InfoBar
                        IsOpen="{Binding AuthenticationMessage, Converter={StaticResource StringPresenceConverter}}"
                        IsClosable="False"
                        Message="{Binding AuthenticationMessage}"
                        Severity="Warning" />
                    <ComboBox
                        Width="300"
                        HorizontalAlignment="Left"
                        Header="Authentication method"
                        ItemsSource="{Binding AuthenticationMethods}"
                        SelectedItem="{Binding SelectedAuthenticationMethod, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Authentication unlocks supported account-restricted media; it cannot add media types that yt-dlp does not support. For example, yt-dlp downloads Flickr videos but not still Flickr photos."
                        TextWrapping="Wrap" />

                    <Border
                        Padding="14"

                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding UsesBrowserAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="Use an existing browser sign-in" />
                            <ComboBox
                                Width="310"
                                HorizontalAlignment="Left"
                                Header="Browser where you are signed in"
                                ItemsSource="{Binding Browsers}"
                                SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="1" />
                                <TextBlock Grid.Column="1" Text="Open the source website in the selected browser." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="2" />
                                <TextBlock Grid.Column="1" Text="Sign in normally and confirm that you can view the media. Ray's Loader never asks for your password." TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="3" />
                                <TextBlock Grid.Column="1" Text="Return here and select Retry preview with sign-in. yt-dlp will read the selected browser's local cookies for this operation." TextWrapping="Wrap" />
                            </Grid>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Message="Firefox is the most reliable option on Windows. If a Chromium browser fails, close it completely before retrying; recent Chrome versions may block cookie decryption." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OpenSourceWebsite_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE774;" />
                                        <TextBlock Text="Open source website" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RlAccentButtonStyle}" Click="RetryPreview_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE721;" />
                                        <TextBlock Text="Retry preview with sign-in" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <HyperlinkButton
                                Padding="0"
                                HorizontalAlignment="Left"
                                Content="Read yt-dlp's official cookie guide"
                                NavigateUri="https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="14"

                        Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding UsesCookiesFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Use a manually exported cookies.txt file" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="The file must use Netscape/Mozilla cookie format. Cookie files can grant account access, so keep them private and never attach them to bug reports."
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Header="Cookies file" Text="{Binding CookiesFile, Mode=TwoWay}" PlaceholderText="Choose cookies.txt" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseCookies_Click">Browse</Button>
                            </Grid>
                            <Button HorizontalAlignment="Left" Style="{StaticResource RlAccentButtonStyle}" Click="RetryPreview_Click">Retry preview with cookies file</Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <Expander Header="Advanced options">
                <StackPanel Spacing="10" Padding="0,10,0,4">
                    <TextBox Header="Additional yt-dlp arguments" Text="{Binding AdditionalArguments, Mode=TwoWay}" PlaceholderText="Optional advanced arguments" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
