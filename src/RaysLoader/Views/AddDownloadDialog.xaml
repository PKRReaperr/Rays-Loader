<ContentDialog
    x:Class="RaysLoader.Views.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RaysLoader.Controls"
    xmlns:models="using:RaysLoader.Models"
    xmlns:viewmodels="using:RaysLoader.ViewModels"
    PrimaryButtonText="ADD &amp; START QUEUE"
    SecondaryButtonText="ADD TO QUEUE"
    CloseButtonText="CANCEL"
    DefaultButton="None"
    KeyDown="Dialog_KeyDown"
    PrimaryButtonStyle="{StaticResource RlBoxDialogAccentButtonStyle}"
    SecondaryButtonStyle="{StaticResource RlBoxDialogButtonStyle}"
    CloseButtonStyle="{StaticResource RlBoxDialogButtonStyle}"
    IsPrimaryButtonEnabled="{Binding CanQueue}"
    IsSecondaryButtonEnabled="{Binding CanQueue}"
    PrimaryButtonClick="PrimaryButton_Click"
    SecondaryButtonClick="SecondaryButton_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <Style x:Key="SectionNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource RlLabelTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource RlAccentTextBrush}" />
        </Style>
        <Style x:Key="SectionNameStyle" TargetType="TextBlock" BasedOn="{StaticResource RlLabelTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource RlTextBrush}" />
        </Style>
        <Style x:Key="SectionRuleStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource RlRuleBrush}" />
        </Style>
        <Style x:Key="OptionComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RlBoxComboBoxStyle}">
            <Setter Property="Width" Value="200" />
        </Style>
        <DataTemplate x:Key="FormatItemTemplate" x:DataType="models:MediaFormat">
            <TextBlock Text="{x:Bind Id, Converter={StaticResource UppercaseConverter}}" />
        </DataTemplate>
        <DataTemplate x:Key="ClipMethodItemTemplate" x:DataType="viewmodels:ClipDownloadMethodOption">
            <TextBlock Text="{x:Bind Label, Converter={StaticResource UppercaseConverter}}" />
        </DataTemplate>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource SectionNumberStyle}" Text="// NEW DOWNLOAD" />
            <TextBlock Style="{StaticResource RlTitleTextStyle}" Text="Add download" />
        </StackPanel>
    </ContentDialog.Title>

    <ScrollViewer
        x:Name="OptionsScrollViewer"
        MaxHeight="620"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            x:Name="ContentPanel"
            Width="840"
            Spacing="14"
            Padding="0,0,12,4"
            Loaded="ContentPanel_Loaded"
            Unloaded="ContentPanel_Unloaded">
            <InfoBar
                IsOpen="{Binding ErrorMessage, Converter={StaticResource StringPresenceConverter}}"
                IsClosable="False"
                Severity="Error"
                Message="{Binding ErrorMessage}" />

            <!-- 01 Source -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionNumberStyle}" Text="01" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNameStyle}" Text="SOURCE" />
                <Border Grid.Column="2" Style="{StaticResource SectionRuleStyle}" />
            </Grid>

            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Style="{StaticResource RlBoxTextBoxStyle}"
                        Text="{Binding Urls, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Paste one or more URLs, one per line"
                        AcceptsReturn="True"
                        MinHeight="64"
                        AutomationProperties.Name="Media URLs">
                        <TextBox.Header><TextBlock Text="Media URL" /></TextBox.Header>
                    </TextBox>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource RlBoxButtonStyle}"
                        VerticalAlignment="Bottom"
                        MinHeight="64"
                        Click="Paste_Click"
                        AutomationProperties.Name="Paste from clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE77F;" />
                            <TextBlock Text="PASTE" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="14" Height="14" IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource RlMonoTextStyle}"
                        Foreground="{ThemeResource RlTextBrush}"
                        Text="{Binding PreviewStatus}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource RlMonoTextStyle}"
                        Foreground="{ThemeResource RlTextMutedBrush}"
                        Text="{Binding UrlInputSummary}" />
                    <HyperlinkButton
                        Grid.Column="3"
                        Padding="0"
                        FontSize="12"
                        Foreground="{ThemeResource RlTextSecondaryBrush}"
                        Content="Browse supported sites"
                        NavigateUri="https://github.com/yt-dlp/yt-dlp/blob/master/supportedsites.md" />
                </Grid>

                <ListView
                    MaxHeight="210"
                    ItemsSource="{Binding Previews}"
                    SelectionMode="None"
                    IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaPreviewItem">
                            <Border
                                Padding="10"
                                Background="{ThemeResource RlSurfaceBrush}"
                                BorderBrush="{ThemeResource RlRuleStrongBrush}"
                                BorderThickness="1">
                                <Grid MinHeight="70" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Height="70" Background="{ThemeResource RlBackgroundBrush}">
                                        <Grid>
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="22"
                                                Foreground="{ThemeResource RlTextMutedBrush}"
                                                Glyph="&#xE8B9;" />
                                            <Image
                                                Source="{x:Bind ThumbnailUrl, Mode=OneWay, Converter={StaticResource NullableImageSourceConverter}}"
                                                Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock
                                            Style="{StaticResource RlSectionTitleTextStyle}"
                                            MaxLines="2"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Style="{StaticResource RlLabelTextStyle}" Text="{x:Bind Source, Mode=OneWay}" />
                                            <TextBlock
                                                Style="{StaticResource RlMonoTextStyle}"
                                                MaxLines="2"
                                                Text="{x:Bind Message, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ProgressRing
                                        Grid.Column="2"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                        Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource RlDangerBrush}"
                                        Glyph="&#xEA39;"
                                        Visibility="{x:Bind HasFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- 02 Format -->
            <Grid ColumnSpacing="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionNumberStyle}" Text="02" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNameStyle}" Text="FORMAT" />
                <Border Grid.Column="2" Style="{StaticResource SectionRuleStyle}" />
            </Grid>

            <StackPanel Spacing="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mode" />
                    <Grid HorizontalAlignment="Left" Width="456" AutomationProperties.Name="Mode">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton GroupName="DownloadMode" Style="{StaticResource RlSegmentStyle}" Content="VIDEO" IsChecked="{Binding IsVideoMode, Mode=TwoWay}" AutomationProperties.Name="Video with audio" />
                        <RadioButton Grid.Column="1" Margin="-1,0,0,0" GroupName="DownloadMode" Style="{StaticResource RlSegmentStyle}" Content="VIDEO ONLY" IsChecked="{Binding IsVideoOnlyMode, Mode=TwoWay}" AutomationProperties.Name="Video only" />
                        <RadioButton Grid.Column="2" Margin="-1,0,0,0" GroupName="DownloadMode" Style="{StaticResource RlSegmentStyle}" Content="AUDIO ONLY" IsChecked="{Binding IsAudioOnlyMode, Mode=TwoWay}" AutomationProperties.Name="Audio only" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox Style="{StaticResource OptionComboStyle}" Header="Video quality" ItemsSource="{Binding VideoQualities}" SelectedItem="{Binding VideoQuality, Mode=TwoWay}" Visibility="{Binding ShowsVideoQuality, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Style="{StaticResource OptionComboStyle}" Header="Container" ItemsSource="{Binding Containers}" SelectedItem="{Binding Container, Mode=TwoWay}" Visibility="{Binding ShowsContainer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Style="{StaticResource OptionComboStyle}" Header="Audio format" ItemsSource="{Binding AudioFormats}" SelectedItem="{Binding AudioFormat, Mode=TwoWay}" Visibility="{Binding ShowsAudioOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Style="{StaticResource OptionComboStyle}" Header="Audio bitrate" ItemsSource="{Binding AudioBitrates}" SelectedItem="{Binding AudioBitrate, Mode=TwoWay}" Visibility="{Binding ShowsAudioOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Style="{StaticResource OptionComboStyle}" Header="Exact format (optional)" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" ItemTemplate="{StaticResource FormatItemTemplate}" PlaceholderText="AUTOMATIC" />
                </StackPanel>
            </StackPanel>

            <!-- 03 Output -->
            <Grid ColumnSpacing="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionNumberStyle}" Text="03" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNameStyle}" Text="OUTPUT" />
                <Border Grid.Column="2" Style="{StaticResource SectionRuleStyle}" />
            </Grid>

            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource RlBoxTextBoxStyle}" Text="{Binding OutputDirectory, Mode=TwoWay}" PlaceholderText="Choose a folder" AutomationProperties.Name="Output folder">
                        <TextBox.Header><TextBlock Text="Output folder" /></TextBox.Header>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource RlBoxButtonStyle}" VerticalAlignment="Bottom" Click="BrowseOutput_Click" AutomationProperties.Name="Browse output folder">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="14" Glyph="&#xE8B7;" /><TextBlock Text="BROWSE" /></StackPanel>
                    </Button>
                    <ToggleButton
                        Grid.Column="2"
                        Style="{StaticResource RlBoxToggleStyle}"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Content="REMEMBER FOLDER"
                        IsChecked="{Binding RememberOutputDirectory, Mode=TwoWay}"
                        ToolTipService.ToolTip="Use this folder as the default for future downloads"
                        AutomationProperties.Name="Remember this folder for future downloads" />
                </Grid>

                <Grid AutomationProperties.Name="Include">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource RlBoxToggleStyle}" Content="SUBTITLES" IsChecked="{Binding WriteSubtitles, Mode=TwoWay}" AutomationProperties.Name="Subtitles" />
                    <ToggleButton Grid.Column="1" Margin="-1,0,0,0" Style="{StaticResource RlBoxToggleStyle}" Content="EMBED METADATA" IsChecked="{Binding EmbedMetadata, Mode=TwoWay}" AutomationProperties.Name="Embed metadata" />
                    <ToggleButton Grid.Column="2" Margin="-1,0,0,0" Style="{StaticResource RlBoxToggleStyle}" Content="THUMBNAIL" IsChecked="{Binding WriteThumbnail, Mode=TwoWay}" AutomationProperties.Name="Thumbnail" />
                    <ToggleButton Grid.Column="3" Margin="-1,0,0,0" Style="{StaticResource RlBoxToggleStyle}" Content="ALLOW PLAYLIST" IsChecked="{Binding DownloadPlaylist, Mode=TwoWay}" AutomationProperties.Name="Allow playlist" />
                </Grid>
            </StackPanel>

            <!-- 04 More -->
            <Grid ColumnSpacing="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionNumberStyle}" Text="04" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionNameStyle}" Text="MORE OPTIONS" />
                <Border Grid.Column="2" Style="{StaticResource SectionRuleStyle}" />
            </Grid>

            <StackPanel Spacing="8">
                <!-- Clip selection -->
                <StackPanel>
                    <ToggleButton x:Name="ClipToggle" Style="{StaticResource RlBoxDisclosureStyle}" Content="CLIP SELECTION" AutomationProperties.Name="Clip selection" />
                    <Border Style="{StaticResource RlBoxDisclosureBodyStyle}" Visibility="{Binding IsChecked, ElementName=ClipToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <ToggleButton
                                Style="{StaticResource RlBoxToggleStyle}"
                                HorizontalAlignment="Left"
                                Content="DOWNLOAD ONLY THE SELECTED RANGE"
                                IsChecked="{Binding TrimEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding CanSelectClip}"
                                AutomationProperties.Name="Download only the selected range" />
                            <Border Style="{StaticResource RlBoxPanelStyle}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="START" Style="{StaticResource RlLabelTextStyle}" />
                                            <TextBlock Text="{Binding TrimStartDisplay}" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="16" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="CLIP LENGTH" HorizontalAlignment="Center" Style="{StaticResource RlLabelTextStyle}" />
                                            <TextBlock Text="{Binding TrimLengthDisplay}" HorizontalAlignment="Center" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="14" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="END" HorizontalAlignment="Right" Style="{StaticResource RlLabelTextStyle}" />
                                            <TextBlock Text="{Binding TrimEndDisplay}" HorizontalAlignment="Right" FontFamily="{StaticResource RlMonoStrongFont}" FontSize="16" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:TrimRangeSlider
                                        Minimum="0"
                                        Maximum="{Binding MediaDurationSeconds}"
                                        StartValue="{Binding TrimStartSeconds, Mode=TwoWay}"
                                        EndValue="{Binding TrimEndSeconds, Mode=TwoWay}"
                                        IsEnabled="{Binding CanSelectClip}"
                                        AutomationProperties.Name="Clip timeline range" />
                                    <Grid>
                                        <TextBlock Text="00:00" Style="{StaticResource RlLabelTextStyle}" />
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding MediaDurationDisplay}" Style="{StaticResource RlLabelTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <ToggleButton x:Name="FineTuneToggle" Style="{StaticResource RlBoxDisclosureStyle}" MinHeight="36" Content="FINE-TUNE TIMES" AutomationProperties.Name="Fine-tune times" />
                                <Border Style="{StaticResource RlBoxDisclosureBodyStyle}" Background="{ThemeResource RlBackgroundBrush}" Visibility="{Binding IsChecked, ElementName=FineTuneToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <NumberBox Header="Start (seconds)" Value="{Binding TrimStartSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding MediaDurationSeconds}" SpinButtonPlacementMode="Compact" CornerRadius="0" />
                                        <NumberBox Grid.Column="1" Header="End (seconds)" Value="{Binding TrimEndSeconds, Mode=TwoWay}" Minimum="0" Maximum="{Binding MediaDurationSeconds}" SpinButtonPlacementMode="Compact" CornerRadius="0" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <ComboBox Style="{StaticResource RlBoxComboBoxStyle}" HorizontalAlignment="Left" MinWidth="360" Header="Clip method" ItemsSource="{Binding ClipMethods}" SelectedItem="{Binding SelectedClipMethod, Mode=TwoWay}" ItemTemplate="{StaticResource ClipMethodItemTemplate}" />
                            <TextBlock Style="{StaticResource RlCaptionTextStyle}" Text="Full quality downloads the selected source streams before FFmpeg trims them. Partial methods transfer less data when the source supports efficient seeking." />
                            <ToggleButton
                                Style="{StaticResource RlBoxToggleStyle}"
                                HorizontalAlignment="Left"
                                Content="PRECISE CUTS (PARTIAL METHODS ONLY; SLOWER)"
                                IsChecked="{Binding ExactBoundaries, Mode=TwoWay}"
                                AutomationProperties.Name="Precise cuts (partial methods only; slower)" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Authentication -->
                <StackPanel>
                    <ToggleButton x:Name="AuthenticationToggle" Style="{StaticResource RlBoxDisclosureStyle}" Content="AUTHENTICATION (OPTIONAL)" IsChecked="{Binding IsAuthenticationExpanded, Mode=TwoWay}" AutomationProperties.Name="Authentication (optional)" />
                    <Border Style="{StaticResource RlBoxDisclosureBodyStyle}" Visibility="{Binding IsChecked, ElementName=AuthenticationToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <InfoBar
                                IsOpen="{Binding AuthenticationMessage, Converter={StaticResource StringPresenceConverter}}"
                                IsClosable="False"
                                Message="{Binding AuthenticationMessage}"
                                Severity="Warning" />
                            <ComboBox
                                Style="{StaticResource RlBoxComboBoxStyle}"
                                Width="300"
                                HorizontalAlignment="Left"
                                Header="Authentication method"
                                ItemsSource="{Binding AuthenticationMethods}"
                                SelectedItem="{Binding SelectedAuthenticationMethod, Mode=TwoWay}" />
                            <TextBlock
                                Style="{StaticResource RlBodyTextStyle}"
                                Text="Authentication unlocks supported account-restricted media; it cannot add media types that yt-dlp does not support. For example, yt-dlp downloads Flickr videos but not still Flickr photos." />

                            <Border
                                Style="{StaticResource RlBoxPanelStyle}"
                                Visibility="{Binding UsesBrowserAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource RlSectionTitleTextStyle}" Text="Use an existing browser sign-in" />
                                    <ComboBox
                                        Style="{StaticResource RlBoxComboBoxStyle}"
                                        Width="310"
                                        HorizontalAlignment="Left"
                                        Header="Browser where you are signed in"
                                        ItemsSource="{Binding Browsers}"
                                        SelectedItem="{Binding SelectedBrowser, Mode=TwoWay}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionNumberStyle}" Text="01" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Open the source website in the selected browser." TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionNumberStyle}" Text="02" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Sign in normally and confirm that you can view the media. Ray's Loader never asks for your password." TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionNumberStyle}" Text="03" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Return here and select Retry preview with sign-in. yt-dlp will read the selected browser's local cookies for this operation." TextWrapping="Wrap" />
                                    </Grid>
                                    <InfoBar
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Message="Firefox is the most reliable option on Windows. If a Chromium browser fails, close it completely before retrying; recent Chrome versions may block cookie decryption." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource RlBoxButtonStyle}" Click="OpenSourceWebsite_Click" AutomationProperties.Name="Open source website">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                                <TextBlock Text="OPEN SOURCE WEBSITE" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RlBoxButtonStyle}" Click="RetryPreview_Click" AutomationProperties.Name="Retry preview with sign-in">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                                <TextBlock Text="RETRY PREVIEW WITH SIGN-IN" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <HyperlinkButton
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Content="Read yt-dlp's official cookie guide"
                                        NavigateUri="https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp" />
                                </StackPanel>
                            </Border>

                            <Border
                                Style="{StaticResource RlBoxPanelStyle}"
                                Visibility="{Binding UsesCookiesFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource RlSectionTitleTextStyle}" Text="Use a manually exported cookies.txt file" />
                                    <TextBlock
                                        Style="{StaticResource RlBodyTextStyle}"
                                        Text="The file must use Netscape/Mozilla cookie format. Cookie files can grant account access, so keep them private and never attach them to bug reports." />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource RlBoxTextBoxStyle}" Text="{Binding CookiesFile, Mode=TwoWay}" PlaceholderText="Choose cookies.txt" AutomationProperties.Name="Cookies file">
                                            <TextBox.Header><TextBlock Text="Cookies file" /></TextBox.Header>
                                        </TextBox>
                                        <Button Grid.Column="1" Style="{StaticResource RlBoxButtonStyle}" VerticalAlignment="Bottom" Click="BrowseCookies_Click" AutomationProperties.Name="Browse for cookies file">BROWSE</Button>
                                    </Grid>
                                    <Button Style="{StaticResource RlBoxButtonStyle}" Click="RetryPreview_Click" AutomationProperties.Name="Retry preview with cookies file">RETRY PREVIEW WITH COOKIES FILE</Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Advanced -->
                <StackPanel>
                    <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource RlBoxDisclosureStyle}" Content="ADVANCED OPTIONS" AutomationProperties.Name="Advanced options" />
                    <Border Style="{StaticResource RlBoxDisclosureBodyStyle}" Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox Style="{StaticResource RlBoxTextBoxStyle}" Text="{Binding AdditionalArguments, Mode=TwoWay}" PlaceholderText="Optional advanced arguments" AutomationProperties.Name="Additional yt-dlp arguments">
                            <TextBox.Header><TextBlock Text="Additional yt-dlp arguments" /></TextBox.Header>
                        </TextBox>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
