<Page
    x:Class="RaysLoader.Views.SupportedSitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:RaysLoader.Models">
    <Grid Padding="28,20,28,28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Supported sites" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Browse the extractors available in your installed yt-dlp version."
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding RefreshCommand}"
                AutomationProperties.Name="Refresh supported sites">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{Binding ErrorMessage, Converter={StaticResource StringPresenceConverter}}"
            Message="{Binding ErrorMessage}"
            Severity="Error" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="7">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding CountText}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding VersionText}" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Website support changes over time, and some sites require login cookies or may be region restricted. Analyze the actual URL to confirm it works."
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    HorizontalAlignment="Left"
                    Content="Open the official yt-dlp supported-sites list"
                    NavigateUri="https://github.com/yt-dlp/yt-dlp/blob/master/supportedsites.md" />
            </StackPanel>
        </Border>

        <AutoSuggestBox
            Grid.Row="3"
            MaxWidth="620"
            HorizontalAlignment="Stretch"
            PlaceholderText="Search websites and extractors"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.Name="Search supported sites">
            <AutoSuggestBox.QueryIcon>
                <SymbolIcon Symbol="Find" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <Grid Grid.Row="4">
            <Border
                Background="{ThemeResource SettingsSectionBodyBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    ItemsSource="{Binding FilteredSites}"
                    SelectionMode="None"
                    Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SupportedSite">
                            <Grid Padding="14,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE909;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ExtractorName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="Generic fallback"
                                        Visibility="{x:Bind IsGeneric, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button
                                        Tag="{Binding}"
                                        Padding="7,3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="KnownIssue_Click"
                                        Visibility="{x:Bind IsKnownBroken, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="View known issue details">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontSize="13"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Glyph="&#xE814;" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Text="Known issue" />
                                        </StackPanel>
                                        <ToolTipService.ToolTip>
                                            <ToolTip Content="View issue details and reports" />
                                        </ToolTipService.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding IsLoading}"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5"
                Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No matching extractors" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Try a shorter website or platform name."
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
