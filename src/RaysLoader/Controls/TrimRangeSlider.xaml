<UserControl
    x:Class="RaysLoader.Controls.TrimRangeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    MinWidth="240"
    Height="62">
    <Canvas
        x:Name="TimelineCanvas"
        Height="62"
        SizeChanged="TimelineCanvas_SizeChanged"
        Tapped="TimelineCanvas_Tapped">
        <Border
            x:Name="Track"
            Height="34"

            Background="{ThemeResource RlSurfaceBrush}"
            BorderBrush="{ThemeResource RlRuleStrongBrush}"
            BorderThickness="1" />
        <Border
            x:Name="BeforeSelection"
            Height="32"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0.72" />
        <Border
            x:Name="AfterSelection"
            Height="32"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Opacity="0.72" />
        <Border
            x:Name="Selection"
            Height="38"

            Background="{ThemeResource RlAccentFillBrush}"
            BorderBrush="{ThemeResource RlAccentFillBrush}"
            BorderThickness="2"
            Opacity="0.28" />

        <primitives:Thumb
            x:Name="StartThumb"
            Width="18"
            Height="52"
            AutomationProperties.Name="Clip start handle"
            DragDelta="StartThumb_DragDelta"
            KeyDown="StartThumb_KeyDown">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border
                        Background="{ThemeResource RlAccentFillBrush}"
                        BorderBrush="{ThemeResource RlAccentLineBrush}"
                        BorderThickness="1"
>
                        <Rectangle Width="2" Height="18" Fill="{ThemeResource RlAccentInkBrush}" />
                    </Border>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
        <primitives:Thumb
            x:Name="EndThumb"
            Width="18"
            Height="52"
            AutomationProperties.Name="Clip end handle"
            DragDelta="EndThumb_DragDelta"
            KeyDown="EndThumb_KeyDown">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                    <Border
                        Background="{ThemeResource RlAccentFillBrush}"
                        BorderBrush="{ThemeResource RlAccentLineBrush}"
                        BorderThickness="1"
>
                        <Rectangle Width="2" Height="18" Fill="{ThemeResource RlAccentInkBrush}" />
                    </Border>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Canvas>
</UserControl>
